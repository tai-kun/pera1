{
  "extends": ["@tsconfig/node24", "@tsconfig/strictest"],
  "include": ["./global.d.ts", "../tests/**/*"],
  "exclude": [
    "../tests/**/*.client.test.ts",
    "../tests/**/*.client.test.tsx",
    "../tests/**/*.server.test.ts",
    "../tests/**/*.server.test.tsx"
  ],
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "noEmit": true,
    "target": "es2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true
  }
}
