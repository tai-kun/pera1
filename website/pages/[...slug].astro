---
import data from "blume:data";
import { getRedirectPaths } from "./_lib/redirect-paths.ts";
import type { RedirectPathProps } from "./_lib/redirect-paths.ts";

/**
 * ロケールなしの URL ごとに、転送先の情報を持つリダイレクトページを生成します。
 */
export function getStaticPaths() {
  return getRedirectPaths(data, import.meta.env?.BASE_URL);
}

const { basePath, targets } = Astro.props as RedirectPathProps;
// クライアント側の言語判定と転送に使うロケールです。設定順に並びます。
const locales = targets.map((target) => target.code);
// 言語設定に合うロケールがなかった場合の転送先です。Blume のフォールバックロケールを優先し、ページを配信していないロケールは使いません。
const fallbackLocale = [data.config.i18n?.fallbackLocale, "en"].find(
  (code): code is string => typeof code === "string" && locales.includes(code)
);
---

<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark light">
    <script
      is:inline
      define:vars={{
        locales,
        fallbackLocale,
        basePath,
      }}
    >
      (() => {
        const matchLocale = () => {
          for (const language of window.navigator.languages ?? []) {
            const tag = language.toLowerCase();
            const matched = locales.find(locale => {
              const code = locale.toLowerCase();
              return tag === code || tag.startsWith(`${code}-`);
            });

            if (matched) {
              return matched;
            }
          }

          return fallbackLocale ?? locales[0];
        };

        const baseSegments = basePath.split("/").filter(Boolean).length;
        const [nextSegment] = window.location.pathname
          .split("/")
          .filter(Boolean)
          .slice(baseSegments);

        // このページがすでにロケール付きの URL で配信されている場合は、ロケールを重ねて転送しないように 404 へ送ります。
        if (locales.includes(nextSegment)) {
          window.location.replace(`${basePath}/404`);
          return;
        }

        // ベースパスの直後にロケールを挿入した URL が Blume の正規 URL です。
        const pathname = `${basePath}/${matchLocale()}${window.location.pathname.slice(basePath.length)}`;

        window.location.replace(
          `${pathname}${window.location.search}${window.location.hash}`,
        );
      })();
    </script>
  </head>

  <body>
    <h1>Redirecting...</h1>
    <p>If you are not redirected automatically, or if you are an AI agent or a client that does not run JavaScript, open one of these pages:</p>
    <ul>
      {
        targets.map((target) => (
          <li>
            <a href={target.href} hreflang={target.code} lang={target.code}>
              {target.label}
            </a>
          </li>
        ))
      }
    </ul>
  </body>
</html>
